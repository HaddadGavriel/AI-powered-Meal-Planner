# Default (no environment variables): validated localStorage mock repository.
NEXT_PUBLIC_MEAL_PLANNER_DATA_MODE=mock
# To connect the documented future backend:
# NEXT_PUBLIC_MEAL_PLANNER_DATA_MODE=http
# NEXT_PUBLIC_MEAL_PLANNER_API_URL=https://api.example.com/api/v1

# FastAPI backend (development values only; replace the secret in every deployment).
MEAL_PLANNER_DATABASE_URL=postgresql+psycopg://meal_planner:meal_planner@localhost:5432/meal_planner
MEAL_PLANNER_JWT_SECRET=development-only-change-me-at-least-32-chars
MEAL_PLANNER_COOKIE_SECURE=false
MEAL_PLANNER_FRONTEND_URL=http://localhost:3000
MEAL_PLANNER_CORS_ORIGINS=http://localhost:3000
